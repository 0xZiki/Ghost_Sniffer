
```bash
# ═══════════════════════════════════════════════════════════
#  GhostSniffer v2.0 — Environment Configuration
# ═══════════════════════════════════════════════════════════
#
#  Copy this file to .env and fill in your operational values.
#  The .env file is gitignored and will NOT be pushed to GitHub.
#
#  Usage:
#    cp .env.example .env    (Linux/Mac)
#    copy .env.example .env  (Windows)
#
# ═══════════════════════════════════════════════════════════

# ── Stealth Domain ───────────────────────────────────────
# Domain used in DNS Mimicry mode (--mimicry dns).
# The scanner will craft a legitimate DNS A-record query
# for this domain inside the UDP payload.
# If unset, defaults to: example.com
STEALTH_DOMAIN=example.com

# ── Decoy IPs ────────────────────────────────────────────
# Comma-separated list of IP addresses used for IP Spoofing.
# These appear as fake source IPs to confuse the Blue Team.
# Leave empty to disable decoys by default.
# Example: DECOY_IPS=192.168.1.1,192.168.1.254,10.0.0.1
DECOY_IPS=

# ── Default Scan Port ────────────────────────────────────
# The destination port used for UDP probe packets.
# If unset, defaults to: 65212
DEFAULT_PORT=65212

# ── Jitter Range (seconds) ──────────────────────────────
# Min/Max random delay between packets when --stealth is used.
# If unset, defaults to: 0.5 / 2.0
JITTER_MIN=0.5
JITTER_MAX=2.0

# ── Report Interval (seconds) ───────────────────────────
# Time between periodic reports in passive mode.
# If unset, defaults to: 30
REPORT_INTERVAL=30